script = ExtResource("9_0o15m")
lines = Array[String](["You didn't trap me?"])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueLines2" type="Node" parent="npc1/DialogueSection/DialogueLoop/DialogueOption/DialogueToggle10/DialogueToggle10" unique_id=742698348]
script = ExtResource("9_0o15m")
lines = Array[String](["[\"My body was possessed\"]", "[\"I was trapped in the basement so I couldn't regain control\"]", "[\"When you unlocked it I got out\"]"])
name_id = 2
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

