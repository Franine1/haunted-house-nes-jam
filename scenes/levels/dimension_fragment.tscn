[node name="DialogueLines" type="Node" parent="windowman/DialogueSection/DialogueToggle/DialogueLoop/DialogueOption/DialogueToggle" unique_id=1155723612]
script = ExtResource("9_0o15m")
lines = Array[String](["Is there any way to get out?"])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueLines2" type="Node" parent="windowman/DialogueSection/DialogueToggle/DialogueLoop/DialogueOption/DialogueToggle" unique_id=816516429]
script = ExtResource("9_0o15m")
lines = Array[String](["...", "I would be lying if I said that it was completely impossible... it's just unheard of.", "I mean... well, I'm probably not the right person to ask.", "After all, I've never managed to escape in all this time. ", "...", "Well, I'll give you this. Hopefully you'll understand everything soon."])
name_id = 3
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

