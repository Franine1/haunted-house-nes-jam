[node name="DialogueLines" type="Node" parent="npc1/DialogueSection/DialogueLoop/DialogueOption/DialogueToggle12/DialogueToggle10" unique_id=182963192]
script = ExtResource("9_0o15m")
lines = Array[String](["Is there any hope for us?", "Lea hesitates before writing."])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueLines2" type="Node" parent="npc1/DialogueSection/DialogueLoop/DialogueOption/DialogueToggle12/DialogueToggle10" unique_id=1089559376]
script = ExtResource("9_0o15m")
lines = Array[String](["[\"There is one way you could escape\"]", "[\"Things might not go back to normal even if you get out\"]", "[\"In this dimension time isn't the same as it is in the real world\"]"])
name_id = 2
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

