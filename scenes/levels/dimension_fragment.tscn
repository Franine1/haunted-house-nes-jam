[node name="DialogueLines" type="Node" parent="npc1/DialogueSection/DialogueLoop/DialogueOption/DialogueToggle11/DialogueToggle10" unique_id=2104792872]
script = ExtResource("9_0o15m")
lines = Array[String](["You were possessed?"])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueLines2" type="Node" parent="npc1/DialogueSection/DialogueLoop/DialogueOption/DialogueToggle11/DialogueToggle10" unique_id=1475214652]
script = ExtResource("9_0o15m")
lines = Array[String](["[\"I learned how to astral project just like you\"]", "[\"A spirit noticed me and trapped me here\"]", "[\"Now I live in the spirit realm and it has my body\"]", "[\"It brought you here to take your body too\"]"])
name_id = 2
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

