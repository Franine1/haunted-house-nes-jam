[node name="DialogueLines" type="Node" parent="windowman/DialogueSection/DialogueToggle/DialogueLoop/DialogueOption/DialogueSection" unique_id=1003808907]
script = ExtResource("9_0o15m")
lines = Array[String](["What happened to this house?"])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueLines2" type="Node" parent="windowman/DialogueSection/DialogueToggle/DialogueLoop/DialogueOption/DialogueSection" unique_id=772062395]
script = ExtResource("9_0o15m")
lines = Array[String](["You're no longer in the house, friend. This place only resembles it since you were in the house a short while ago.", "In a sense, you could say you've \"escaped\", like you wanted.", "Though I expect you'll realize this place is where all of the problems were coming from in the first place."])
name_id = 3
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueSection2" type="Node" parent="windowman/DialogueSection/DialogueToggle/DialogueLoop/DialogueOption" unique_id=547731256]
script = ExtResource("11_rnfe7")
metadata/_custom_type_script = "uid://lrhymco58lj0"

[node name="DialogueLines" type="Node" parent="windowman/DialogueSection/DialogueToggle/DialogueLoop/DialogueOption/DialogueSection2" unique_id=498593783]
script = ExtResource("9_0o15m")
lines = Array[String](["Who's that ghost in the corner?"])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueLines2" type="Node" parent="windowman/DialogueSection/DialogueToggle/DialogueLoop/DialogueOption/DialogueSection2" unique_id=1267009834]
script = ExtResource("9_0o15m")
lines = Array[String](["You've been looking for Lea for a while now, haven't you?", "Well, you've found her now."])
name_id = 3
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueSection3" type="Node" parent="windowman/DialogueSection/DialogueToggle/DialogueLoop/DialogueOption" unique_id=1260027477]
script = ExtResource("11_rnfe7")
metadata/_custom_type_script = "uid://lrhymco58lj0"

[node name="DialogueLines" type="Node" parent="windowman/DialogueSection/DialogueToggle/DialogueLoop/DialogueOption/DialogueSection3" unique_id=317144459]
script = ExtResource("9_0o15m")
lines = Array[String](["Why can't I astral project?"])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueLines2" type="Node" parent="windowman/DialogueSection/DialogueToggle/DialogueLoop/DialogueOption/DialogueSection3" unique_id=1969920254]
script = ExtResource("9_0o15m")
lines = Array[String](["Astral Projection is the act of removing your soul from your body, and sending it into the Astral Plane.", "Your soul will remained tethered to your body, meaning you can choose to return to normal at any time.", "...", "I can't see your tether attached to your soul anymore.", "In other words, the connection between your body and soul has been destroyed, meaning unless you can find your body, returning to normal is impossible."])
name_id = 3
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueToggle" type="Node" parent="windowman/DialogueSection/DialogueToggle/DialogueLoop/DialogueOption" unique_id=1286079494]
