[node name="DialogueLines" type="Node" parent="npc1/DialogueSection/DialogueLoop/DialogueOption/DialogueToggle13/DialogueToggle10" unique_id=1130100085]
script = ExtResource("9_0o15m")
lines = Array[String](["Tell me about the spirit"])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueLines2" type="Node" parent="npc1/DialogueSection/DialogueLoop/DialogueOption/DialogueToggle13/DialogueToggle10" unique_id=1945609752]
script = ExtResource("9_0o15m")
lines = Array[String](["[\"I don't know much about it\"]", "[\"I know it's been on this mountain for a long time\"]", "[\"Many people have become possessed and got trapped here\"]", "[\"It wants to collect as many bodies as possible to use\"]", "[\"Once you astral project it has a window to steal yours\"]", "[\"So it traps people and tricks them into thinking astral projecting is safe\"]", "[\"Why do you think you could always get through areas by astral projecting?\"]", "[\"It wants to force you to do it as much as possible\"]", "[\"Until the connection to your body is weak enough to be severed\"]"])
name_id = 2
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

