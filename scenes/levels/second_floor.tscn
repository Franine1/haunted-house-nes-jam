[node name="DialogueLines4" type="Node" parent="peanut butter/DialogueSection/DialogueToggle/DialogueLoop/DialogueToggle2/DialogueOption/DialogueToggle4/DialogueToggle2" unique_id=196988174]
script = ExtResource("16_2waup")
lines = Array[String](["What...? You too?!", "You're like the fifth guy who randomly asks me if I want to help you! No, I don't want to help you!", "Do I really have such a kind face? Do I look like the kind of person who would help you?", "Why do you think I don't go anywhere else in this house?! I just want people to stop asking me that!!", "It's like a curse. I mean, who on Earth just asks random people to help them? Especially if it's just a swarm of ra...", "...", "...Almost let the rat out of the bag there.", "Either way, I'd much rather help myself to some peanut butter, if you ask me.", "...", "Hey, maybe we can figure things out, actually.", "If you let me help myself to your peanut butter, you can help yourself get helped with my help.", "Capiche?"])
name_id = 4
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

