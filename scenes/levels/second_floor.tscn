[node name="DialogueLines" type="Node" parent="Blockade8/DialogueSection/DialogueOption" unique_id=1054005097]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"Although it's shocking to believe, the statistics have proven again and again that the classic saying is more than fiction.\"", "\"The news is undoubtedly groundbreaking, and questions every theory made to date. Currently most of those involved are attempting to disprove this phenomenon.\"", "\"Regardless, we personally welcome the notion that wishing on a star can actually grant your desires.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

