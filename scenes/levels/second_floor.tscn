[node name="DialogueLines" type="Node" parent="Blockade18/DialogueSection/DialogueOption" unique_id=1383199753]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"After the refugees were able to be extracted, the opposition no longer had any sufficient advantage, and quickly fell.\"", "\"Regardless, the true scale of these illicit acts was unprecedented. The human rights of the refugees had been outright ignored by the perpetrators.\"", "\"It was discovered the eyes and teeth of the refugees had been ground into a paste, which was then combined with insect scales and harmful vegetation to create a powerful poison.\"", "\"However, despite the fact the poison was detected in all of the cultists, no signs of physical harm were exhibited in any of them.\"", "\"On the contrary, the offensive force used to wipe them out had multiple members suddenly become ill, to the point of paralysis or even death.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

