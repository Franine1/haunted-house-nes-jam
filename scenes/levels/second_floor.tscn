[node name="DialogueLines" type="Node" parent="Blockade5/DialogueSection/DialogueOption" unique_id=358774005]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"Out of all of those reports, over ninety-six percent didn't reach the press.\"", "\"Despite the congruency between what all of these deep-sea divers had found in the Vanessa Rift Valley, it seemed the world did not want their experiences to be known.\"", "\"Within the next month, all of them died from natural causes. The reports of glowing children walking across the seafloor never arose since.\""])
