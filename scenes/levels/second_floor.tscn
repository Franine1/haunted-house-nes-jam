[node name="DialogueLines" type="Node" parent="Blockade10/DialogueSection/DialogueOption" unique_id=2036686159]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"The practice of salting taxidermy has fallen into obscurity, but the origins of the practice are from a small clan in the Arramundo Mountains.\"", "\"The legends passed down through their heritage detail the volatility of both life and death, and how sentient creatures can exist on both sides.\"", "\"Using taxidermy itself was a religious practice for their group to honor nature gods, but any taxidermy was carefully guarded and frequently salted.\"", "\"Failure to do so was considered a high crime. It was believed spirits could possess the empty bodies and attempt to infiltrate the material world.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

