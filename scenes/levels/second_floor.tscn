[node name="DialogueLines" type="Node" parent="Blockade12/DialogueSection/DialogueOption" unique_id=474884755]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"Therefore, continued claims attempting to support this outrageous theory will henceforth be censored from the press.\"", "\"Our time and printing space has been wasted endlessly ever since this outburst of fantastical scientists arose, most of whom fail to acknowledge the pure basics of the scientific process in making their claims.\"", "\"Specifically, this group hallucination is founded on experiments that are not reproducable.\"", "\"It was a shame when the esteemed Professor Eucalyse also found herself hypnotized by this fanatic belief.\"", "\"To continuously argue that magnetic fields have the capacity for speech lacks all reason.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

