[node name="DialogueLines" type="Node" parent="Blockade11/DialogueSection/DialogueOption" unique_id=1843126014]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"Apparently, it's a frequent occurrence for humans to hear voices speaking to them while they sleep.\"", "\"Observations of brain waves on unsuspecting patients has shown activity in the auditory and language areas.\"", "\"It's also common for subjects to exhibit patterns indicating the desire to respond. However, no patients can recall any conservations upon awakening.\"", "\"Strangely, this phenomenon is completely absent in those who are aware they are being monitored before going to sleep.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

