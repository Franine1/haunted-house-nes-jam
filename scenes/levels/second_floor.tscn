lines = Array[String](["Why peanut butter?"])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueLines2" type="Node" parent="peanut butter/DialogueSection/DialogueToggle/DialogueLoop/DialogueToggle2/DialogueOption/DialogueToggle3" unique_id=1249238694]
script = ExtResource("16_2waup")
lines = Array[String](["Why all the questions, eh?! ", "Don't even joke, lad. I don't play when it comes to peanut butter.", "Go get some jelly if you want to play games. Make some game jam."])
name_id = 4
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueLines3" type="Node" parent="peanut butter/DialogueSection/DialogueToggle/DialogueLoop/DialogueToggle2/DialogueOption/DialogueToggle3" unique_id=196215253]
