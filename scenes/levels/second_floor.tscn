[node name="DialogueLines4" type="Node" parent="peanut butter/DialogueSection/DialogueToggle/DialogueLoop/DialogueToggle2/DialogueOption/DialogueToggle2" unique_id=1553515332]
script = ExtResource("16_2waup")
lines = Array[String](["Ack! Ach!! Ugh!!", "Guess I bit off more than I can chew.", "WHat were we talking about again?"])
