[node name="DialogueLines" type="Node" parent="Blockade15/DialogueSection/DialogueOption" unique_id=1271807699]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"Although the notion of 'astral projection' seems bizarre, the idea has arisen in countless cultures independently across the globe.\"", "\"Specifically, this would involve projecting one's soul out of the body into the Astral Plane, an apparent facsimile of the regular world.\"", "\"An invisible astral tether would allow the savant to return to their body at will, so long as it remains intact.\"", "\"Most depictions of the Astral Plane indicate it would be inhabited by spirits, which would be sentient creatures that exist in death rather than life.\"", "\"It is expected changes in the Astral Plane may directly or indirectly influence much of the Material Plane.\" "])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

