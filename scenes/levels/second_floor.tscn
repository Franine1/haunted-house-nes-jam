[node name="DialogueLines2" type="Node" parent="peanut biter/DialogueSection/DialogueToggle/DialogueLoop/DialogueToggle2/DialogueOption/DialogueToggle5/DialogueToggle7/DialogueToggle2" unique_id=1198954952]
script = ExtResource("16_2waup")
lines = Array[String](["Sucks to say, but I already devoured al the rest of the peanut butter around here.", "You're gonna have to look, like, really far and wide if you wanna find some more.", "The good news is, now that you know what it looks like, I bet you'll be able to spot peanut butter where you didn't notice it before! Heh heh!"])
name_id = 4
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

