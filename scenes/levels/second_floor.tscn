[node name="DialogueLines" type="Node" parent="Blockade6/DialogueSection/DialogueOption" unique_id=1382054527]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"After the fort had succumbed to their assult, the legion army was seemingly doomed.\"", "\"With all allies having given up on them, and the Empire's army soon upon them, the commander ordered his soldiers to defend a small room.\"", "\"Without an explanation, he exhausted all the lights and went inside. Once six minutes had passed, he returned.\"", "\"In that short timespan, all the opposing commanders had suddenly perished by pure chance.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

