[node name="DialogueLines2" type="Node" parent="peanut biter/DialogueSection/DialogueToggle/DialogueLoop/DialogueToggle2/DialogueOption/DialogueToggle5/DialogueToggle7/DialogueToggle" unique_id=217592954]
script = ExtResource("16_2waup")
lines = Array[String](["Hey, that's supposed to be your job, bucko!", "Ugh. Youngins'. Never wanting to do work of their own.", "The thing is, I don't know either.", "I mean, I know it's in the, uh. The balcony.", "Lea was gonna give me the directions to it, but...", "she was gonna write it down right before she left, but the deal went up in the air.", "...", "Did I just say something important?"])
name_id = 4
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueToggle2" type="Node" parent="peanut biter/DialogueSection/DialogueToggle/DialogueLoop/DialogueToggle2/DialogueOption/DialogueToggle5/DialogueToggle7" unique_id=335114539]
