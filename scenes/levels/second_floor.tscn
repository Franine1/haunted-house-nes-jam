[node name="DialogueLines" type="Node" parent="Blockade17/DialogueSection/DialogueOption" unique_id=145813676]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"The implications of this technology could be groundbreaking.\"", "\"Though the research is still lacking, our models show unexpected behavior when E.M. waves are treated as higher dimensional tensor fields, and emitted through series of commutators.\"", "\"The signals become effectively immune to error, are are capable of simulating physical space and objects without requiring materials or additional energy input.\"", "\"Human brains seem to be perfect receptors for these types of waves, as well. The chance of a statistical anomaly in the correlation is less than 0.03%.\"", "\"If this technology was developed, the possibilities are far beyond telepathy. It would be possible to have full control over the minds of any person that these signals interact with.\"", "\"There is some evidence these signals can interact with the physical world as well, but the results have been inconsistent.\"", "\"It's imperative this discovery is both understood, but also regulated correctly.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

