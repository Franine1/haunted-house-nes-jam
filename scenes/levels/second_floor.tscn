[node name="DialogueLines" type="Node" parent="Blockade14/DialogueSection/DialogueOption" unique_id=1811438158]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"Although all of the most impressive models of the universe would indicate our galaxy is in a 'Cosmic Void', several inconsistencies stick out like sore thumbs.\"", "\"For one, our best models would predict slower rates of star formation, yet stars seem to be born and die an order of magnitude more than in the rest of the observable universe.\"", "\"The biggest inconsistency is the sheer volume of dark matter present in our galaxy. Even more interesting is that it seems to be concentrated near our solar system primarily.\"", "\"The impacts this could have on our solar system's future is still debated.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueLines2" type="Node" parent="Blockade14/DialogueSection/DialogueOption" unique_id=391633321]
script = ExtResource("16_2waup")
