[node name="DialogueLines" type="Node" parent="Blockade19/DialogueSection/DialogueOption" unique_id=945594979]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"So far, only four cases have ever been reported. The sudden onset is predicted to lead to misdiagnosis as schizophrenia in additional cases.\"", "\"Especially due to the almost supernatural nature if its effects, detection is likely to only occur in a fraction of a percent of occurrences.\"", "\"Those affected suddenly lose all memories of their life, and express that they've lived an alternate life as a completely different person.\"", "\"The symptoms seem similar to ego death or a complete personality change, but the distinguishing feature is that there is proof of their previous life having actually existed.\"", "\"Medical records and contracts are often found that prove the life described did happen; these 'former lives' are generally missing persons elsewhere in the world.\"", "\"In all cases, the 'former life' seems to be remembered by none of these 'former acquaintances', and the individual is only discovered to be missing after a case of Spiritual-Dissonance Syndrome is diagnosed.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

