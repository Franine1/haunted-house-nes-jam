script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"For generations, the burial spot remained the mass grave of all of the members of the Ludivine family.\"", "\"The tomb accepted all of the dead, confused, or misguided. They would venture into its depths to seek meaning beyond life.\"", "\"Those who returned either came with insight or insanity.\""])
