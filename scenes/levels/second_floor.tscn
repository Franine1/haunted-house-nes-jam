[node name="DialogueLines" type="Node" parent="Blockade16/DialogueSection/DialogueOption" unique_id=504203855]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"Despite our continued efforts at uncovering the methods, we've been unable to reproduce any of these myths with any of the described methods.\"", "\"Our best theory is that, should these stories prove true, there is a narrow window of people, places and times that permit this phenomenon.\"", "\"In one outstanding experiment, the subject who attempted to perform this feat exhibited signs synonymous with becoming deceased.\"", "\"Before life-saving measures could be taken, the subject reawoke, with no unusual behavior.\"", "\"Although the subject had been dead for approximately 20 seconds, their behavior returned to normal instantly with no long-term side effects.\"", "\"The only inconsistency was a dramatic change in brain wave patterns, a change prominent enough that most subjects would be expected to have severe amnesia and loss of motor function.\"", "\"On the surface, the only visible difference was a change in the dominant hand, and differences in speaking patterns.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueLines2" type="Node" parent="Blockade16/DialogueSection/DialogueOption" unique_id=502961706]
