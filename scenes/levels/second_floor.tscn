[node name="DialogueLines" type="Node" parent="Blockade13/DialogueSection/DialogueOption" unique_id=1893973804]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"After days on end of starving in the Genesis Desert Plains, the nomad found himself no longer able to even drag himself through the sand.\"", "\"The desert had consumed any hope of escape, and not even scorpions and cacti could survive in the hottest part of these dunes.\"", "\"His pilgrimage had always been his priority, and he went into this prepared for any fate that befell him.\"", "\"His mind was immune to the tempations of mirages, whether they depicted oases of water or food and shelter.\"", "\"However, moments before he would've reached a fatal level of sun poisoning, he saw a mirage that took his own form.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

