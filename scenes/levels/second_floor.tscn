[node name="DialogueLines" type="Node" parent="Blockade7/DialogueSection/DialogueOption" unique_id=1510471109]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"In this dream, he had the sensation he was flying across the sky, weightlessly and effortlessly.\"", "\"Before he awoke, he became able to perceive emotions and thoughts like colors floating through the air.\"", "\"His story seemed bizarre, but his ability to read minds continued to shock the world.\"", "\"On one fateful day, his story changed forever. The boy witnessed a person no one else could see.\"", "\"He declared he would attempt to read their mind. Within half a second, he collapsed, dead.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

