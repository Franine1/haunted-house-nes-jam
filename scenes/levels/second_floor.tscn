[node name="DialogueLines" type="Node" parent="Blockade4/DialogueSection/DialogueOption" unique_id=1228069887]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"This doctor was not only capable of miracles, but he himself was immune to illness, and even brought back the dead.\"", "\"It was believed he had been given the heavenly gift of life. He protected his town for over one hundred and fifty years.\"", "\"Suddenly, in his age he grew resentful. The old wounds of those he healed suddenly returned to them.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

