[node name="DialogueLines" type="Node" parent="Blockade9/DialogueSection/DialogueOption" unique_id=1744837684]
script = ExtResource("16_2waup")
lines = Array[String](["Read it", "You skim to an interesting passage:", "\"Events like this one are being dubbed, 'Collective Cognitive Disrupture'.\"", "\"It still isn't clear how these events take place, but there is reasearch being done into the effects of air pressure and humidity on human psycology.\"", "\"Remarkably, almost all of these events appear to be targetted in some way. It's hard to write this off as a coincidence.\"", "\"For example, in the 1973 Yamato City bank robbery, it was found that all officers patrolling the area simultaneously entered a vegetative state around the time of the crime.\"", "\"None of the victims went on to recover.\""])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

