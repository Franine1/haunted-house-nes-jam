[node name="DialogueLines5" type="Node" parent="Blockade2/DialogueSection/DialogueToggle/DialogueToggle6/DialogueOption/DialogueSection" unique_id=1798122873]
script = ExtResource("5_u8ura")
lines = Array[String](["You get the chair anchored at the clock's feet.", "...", "There isn't a lot of stable footing on the clock. It's wobbling as you try to climb on top of it.", "You get your hands on the top, but there's nothing to grab and pull yourself up with.", "You take off your shoes to get a better grip."])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueCue" type="Node" parent="Blockade2/DialogueSection/DialogueToggle/DialogueToggle6/DialogueOption/DialogueSection" unique_id=1186403234]
