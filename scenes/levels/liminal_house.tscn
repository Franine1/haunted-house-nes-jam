metadata/_custom_type_script = "uid://xhrymkbacnrg"

[node name="DialogueLines" type="Node" parent="Blockade2/DialogueSection/DialogueToggle/DialogueToggle6/DialogueOption/DialogueSection" unique_id=1105468197]
script = ExtResource("5_u8ura")
lines = Array[String](["The clock suddenly lost it's balance when you climbed down and took your shoes off.", "Wait, really? What are you supposed to do, then? ", "Is escape even possible?", "Are you trapped? All because you wanted to reconnect with an old friend?", "Are you gonna starve in here? Or will you die from thirst?"])
metadata/_custom_type_script = "uid://cqejfq3mk4wi8"

[node name="DialogueCue2" type="Node" parent="Blockade2/DialogueSection/DialogueToggle/DialogueToggle6/DialogueOption/DialogueSection" unique_id=13284838]
